# ArxivMirror Configuration
# Copy to .env and modify as needed

ARXIV_MIRROR_DATA_DIR=./data
ARXIV_MIRROR_DATABASE_URL=postgresql+asyncpg://arxiv_mirror:arxiv_mirror@localhost:5432/arxiv_mirror
ARXIV_MIRROR_API_HOST=127.0.0.1
ARXIV_MIRROR_API_PORT=8900

# Proxy (leave empty to disable)
ARXIV_MIRROR_HTTP_PROXY=
ARXIV_MIRROR_HTTPS_PROXY=

# OAI-PMH
ARXIV_MIRROR_OAIPMH_BASE_URL=https://oaipmh.arxiv.org/oai
ARXIV_MIRROR_OAIPMH_POLITE_DELAY_SECONDS=3.0

# PDF Download
ARXIV_MIRROR_PDF_DOWNLOAD_CONCURRENCY=8
ARXIV_MIRROR_ARXIV_DOWNLOAD_DELAY_SECONDS=3.0

# S3 Mirror (optional)
ARXIV_MIRROR_S3_MIRROR_ENABLED=false

# MinerU (optional)
ARXIV_MIRROR_MINERU_ENABLED=false
